<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Game <%= gameId %></title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #1b1b1b;
        color: white;
      }

      header {
        padding: 20px;
        background: #252525;
        border-bottom: 1px solid #444;
      }

      h1 {
        margin: 0;
      }

      main {
        max-width: 1200px;
        margin: auto;
        padding: 25px;
      }

      .card {
        background: #2b2b2b;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 30px;
      }

      img,
      canvas {
        width: 100%;
        image-rendering: pixelated;
        border: 1px solid #444;
      }

      button {
        margin-top: 10px;
      }

      progress {
        width: 100%;
        height: 20px;
      }

      code {
        color: #7ed6ff;
      }
    </style>
  </head>

  <body>
    <header>
      <h1>OpenFront Game Analysis Viewer</h1>
      <p>
        Game ID: <code><%= gameId %></code>
      </p>
    </header>

    <main>
      <div class="card">
        <h2>Status</h2>

        <p id="status">Connecting...</p>

        <progress id="progress" max="100" value="0"></progress>
      </div>

      <div class="card">
        <h2>Conquered Tiles Heatmap</h2>
        <img id="conquered" />
      </div>

      <div class="card">
        <h2>Trade Ship Routes Heatmap</h2>
        <img id="trade" />
      </div>

      <div class="card">
        <h2>Pirating Heatmap</h2>
        <img id="pirating" />
      </div>

      <div class="card">
        <h2>Timelapse</h2>

        <canvas id="map"></canvas>

        <div
          style="
            margin-top: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
          "
        >
          <button onclick="previousFrame()">◀ Previous</button>

          <input
            id="frameSlider"
            type="range"
            min="0"
            max="0"
            value="0"
            style="flex: 1"
          />

          <button onclick="nextFrame()">Next ▶</button>
        </div>
      </div>
    </main>

    <script>
      const gameId = "<%= gameId %>";
      const frameCache = new Map();
      const socket = new WebSocket(`ws://${location.host}/ws`);

      const status = document.getElementById("status");
      const progress = document.getElementById("progress");

      const conquered = document.getElementById("conquered");
      const trade = document.getElementById("trade");
      const pirating = document.getElementById("pirating");

      const canvas = document.getElementById("map");
      const ctx = canvas.getContext("2d");

      const frameSlider = document.getElementById("frameSlider");

      const inProgressFrames = new Set();

      let width = 0;
      let height = 0;

      let borderFrames = [];
      let conquestFrames = [];

      let frame = 0;

      const bg = new Image();

      socket.onopen = () => {
        socket.send(
          JSON.stringify({
            type: "runGame",
            gameId,
          }),
        );
      };

      socket.onmessage = ({ data }) => {
        const msg = JSON.parse(data);

        switch (msg.type) {
          case "status":
            status.textContent = msg.message;
            break;

          case "progress":
            progress.value = msg.value;
            break;

          case "finished":
            loadGame(msg.data);
            break;

          case "error":
            status.textContent = msg.error;
            console.error(msg.error);
            break;
          case "frame":
            const bytes = Uint8ClampedArray.from(atob(msg.rgba), (c) =>
              c.charCodeAt(0),
            );
            frameCache.set(msg.frame, new ImageData(bytes, width, height));
            inProgressFrames.delete(msg.frame);
            if (frame !== msg.frame) break;
            ctx.putImageData(frameCache.get(msg.frame), 0, 0);
            break;
        }
      };

      function loadGame(data) {
        status.textContent = "Finished!";
        progress.value = 100;

        width = data.width;
        height = data.height;

        canvas.width = width;
        canvas.height = height;

        borderFrames = data.borderFrames;
        conquestFrames = data.conquestFrames;

        // Configure slider
        frameSlider.max = borderFrames.length - 1;
        frameSlider.value = 0;

        conquered.src = "data:image/png;base64," + data.conqueredTilesHeatmap;
        trade.src = "data:image/png;base64," + data.tradeShipRoutesHeatmap;
        pirating.src = "data:image/png;base64," + data.piratingHeatmap;

        bg.onload = () => drawFrame(0);
        bg.src = "data:image/png;base64," + data.background;
      }
      function drawFrame(index) {
        if (frameCache.has(index)) {
          ctx.putImageData(frameCache.get(index), 0, 0);
        } else if (!inProgressFrames.has(index)) {
          inProgressFrames.add(index);
          socket.send(
            JSON.stringify({
              type: "frame",
              gameId,
              frame: index,
            }),
          );
        }

        // Always prefetch ahead
        for (
          let i = index + 1;
          i <= Math.min(index + 10, borderFrames.length - 1);
          i++
        ) {
          if (!frameCache.has(i) && !inProgressFrames.has(i)) {
            inProgressFrames.add(i);
            socket.send(
              JSON.stringify({
                type: "frame",
                gameId,
                frame: i,
              }),
            );
          }
        }
      }

      function nextFrame() {
        if (frame < borderFrames.length - 1) {
          frame++;
          frameSlider.value = frame;
          drawFrame(frame);
        }
      }

      function previousFrame() {
        if (frame > 0) {
          frame--;
          frameSlider.value = frame;
          drawFrame(frame);
        }
      }

      frameSlider.addEventListener("input", () => {
        frame = Number(frameSlider.value);
        drawFrame(frame);
      });
    </script>
  </body>
</html>
