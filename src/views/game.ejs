<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Game <!= gameId !></title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #1b1b1b;
        color: white;
      }

      header {
        padding: 20px;
        background: #252525;
        border-bottom: 1px solid #444;
      }

      h1 {
        margin: 0;
      }

      main {
        max-width: 1200px;
        margin: auto;
        padding: 25px;
      }

      .card {
        background: #2b2b2b;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 30px;
      }

      img {
        width: 100%;
        image-rendering: pixelated;
        border: 1px solid #444;
      }

      video {
        width: 100%;
        border: 1px solid #444;
      }

      code {
        color: #7ed6ff;
      }
    </style>
  </head>

  <body>
    <header>
      <h1>OpenFront Game Analysis Viewer</h1>
      <p>
        Game ID: <code><%= gameId %></code>
      </p>
    </header>

    <main>
      <div class="card">
        <h2>Conquered Tiles Heatmap</h2>

        <% if (heatmap) { %>
        <img src="data:image/png;base64,<%= heatmap %>" />
        <% } else { %>
        <p>No heatmap generated.</p>
        <% } %>
      </div>

      <div class="card">
        <h2>Timelapse</h2>
        <script>
          const borderFrames = JSON.stringify(borderFrames);
          const conquestFrames = JSON.stringify(conquestFrames);

          let currentFrame = 0;

          const background = "data:image/png;base64" + background;

          const canvas = document.getElementById("map");
          const ctx = canvas.getContext("2d");

          canvas.width = width;
          canvas.height = height;

          let frame = 0;

          const bg = new Image();

          bg.onload = () => {
            drawFrame(0);
          };

          bg.src = background;

          function drawFrame(index) {
            frame = index;

            ctx.drawImage(bg, 0, 0);

            // Draw borders
            ctx.fillStyle = "black";

            for (const tile of borderFrames[index]) {
              const x = tile % width;
              const y = Math.floor(tile / width);

              ctx.fillRect(x, y, 1, 1);
            }

            // Draw conquest heatmap
            const conquest = conquestFrames[index];

            for (const tile in conquest) {
              const count = conquest[tile];

              const x = tile % width;
              const y = Math.floor(tile / width);

              // replace this with your interpolateColor()
              const intensity = Math.min(count / 100, 1);

              ctx.fillStyle = `rgba(0,0,255,${intensity})`;

              ctx.fillRect(x, y, 1, 1);
            }

            document.getElementById("frame").innerText =
              `${index}/${borderFrames.length}`;
          }

          function nextFrame() {
            if (frame < borderFrames.length - 1) drawFrame(frame + 1);
          }

          function previousFrame() {
            if (frame > 0) drawFrame(frame - 1);
          }
        </script>
        <div>
          <button onclick="previousFrame()">◀ Previous</button>

          <span id="frame"> Frame 0 </span>

          <button onclick="nextFrame()">Next ▶</button>
        </div>
      </div>
    </main>
  </body>
</html>
