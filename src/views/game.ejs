<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Game <%= gameId %></title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #1b1b1b;
        color: white;
      }

      header {
        padding: 20px;
        background: #252525;
        border-bottom: 1px solid #444;
      }

      h1 {
        margin: 0;
      }

      main {
        max-width: 1200px;
        margin: auto;
        padding: 25px;
      }

      .card {
        background: #2b2b2b;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 30px;
      }

      img,
      canvas {
        width: 100%;
        image-rendering: pixelated;
        border: 1px solid #444;
      }

      button {
        margin-top: 10px;
      }

      progress {
        width: 100%;
        height: 20px;
      }

      code {
        color: #7ed6ff;
      }
    </style>
  </head>

  <body>
    <header>
      <h1>OpenFront Game Analysis Viewer</h1>
      <p>
        Game ID: <code><%= gameId %></code>
      </p>
    </header>

    <main>
      <div class="card">
        <h2>Status</h2>

        <p id="status">Connecting...</p>

        <progress id="progress" max="100" value="0"></progress>
      </div>

      <div class="card">
        <h2>Conquered Tiles Heatmap</h2>
        <img id="conquered" />
      </div>

      <div class="card">
        <h2>Trade Ship Routes Heatmap</h2>
        <img id="trade" />
      </div>

      <div class="card">
        <h2>Pirating Heatmap</h2>
        <img id="pirating" />
      </div>

      <div class="card">
        <h2>Timelapse</h2>

        <canvas id="map"></canvas>

        <div
          style="
            margin-top: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
          "
        >
          <button onclick="playVideo()">Play</button>
          <button onclick="stopVideo()">Pause</button>
          <button onclick="previousFrame()">◀ Previous</button>

          <input
            id="frameSlider"
            type="range"
            min="0"
            max="0"
            value="0"
            style="flex: 1"
          />

          <button onclick="nextFrame()">Next ▶</button>
          <br />
          <button onclick="fetchAllFrames()">Fetch all frames</button>
        </div>
      </div>
    </main>

    <script>
      const gameId = "<%= gameId %>";
      const frameCache = new Map();
      const socket = new WebSocket(`ws://${location.host}/ws`);
      socket.binaryType = "arraybuffer";
      const status = document.getElementById("status");
      const progress = document.getElementById("progress");

      const conquered = document.getElementById("conquered");
      const trade = document.getElementById("trade");
      const pirating = document.getElementById("pirating");

      const canvas = document.getElementById("map");
      const ctx = canvas.getContext("2d");

      const frameSlider = document.getElementById("frameSlider");

      const inProgressFrames = new Set();

      let width = 0;
      let height = 0;

      let frame = 0;

      const bg = new Image();

      socket.onopen = () => {
        socket.send(
          JSON.stringify({
            type: "runGame",
            gameId,
          }),
        );
      };

      socket.onmessage = ({ data }) => {
        // Binary frame
        if (data instanceof ArrayBuffer) {
          const bytes = new Uint8Array(data);

          const type = bytes[0];
          if (type === 4) {
            const view = new DataView(data);

            const frameIndex = view.getUint32(1, true);

            const pixels = new Uint8ClampedArray(data, 5);

            const image = new ImageData(pixels, width, height);

            if (!frameCache.has(frameIndex)) {
              loadedFrames++;
            }

            frameCache.set(frameIndex, image);

            inProgressFrames.delete(frameIndex);

            if (frame === frameIndex) {
              ctx.putImageData(image, 0, 0);
            }
          } else {
            const imageBytes = bytes.slice(1);

            const blob = new Blob([imageBytes], {
              type: "image/png",
            });

            const url = URL.createObjectURL(blob);

            switch (type) {
              case 0:
                conquered.src = url;
                break;
              case 1:
                trade.src = url;
                break;
              case 2:
                pirating.src = url;
                break;
              case 3:
                bg.src = url;
                drawFrame(0);
                break;
            }
          }

          return;
        }

        // JSON messages
        const msg = JSON.parse(data);

        switch (msg.type) {
          case "status":
            status.textContent = msg.message;
            break;

          case "progress":
            progress.value = msg.value;
            break;

          case "finished":
            loadGame(msg.data);
            fetchAllFrames();
            break;

          case "error":
            status.textContent = msg.error;
            console.error(msg.error);
            break;
        }
      };
      let totalFrames = 0;
      let loadedFrames = 0;
      function loadGame(data) {
        status.textContent = "Finished!";
        progress.value = 100;

        width = data.width;
        height = data.height;

        canvas.width = width;
        canvas.height = height;

        totalFrames = data.frameCount;
        frameSlider.max = totalFrames - 1;
        frameSlider.value = 0;
      }

      function fetchFrame(index) {
        if (!frameCache.has(index) && !inProgressFrames.has(index)) {
          inProgressFrames.add(index);
          socket.send(
            JSON.stringify({
              type: "frame",
              gameId,
              frame: index,
            }),
          );
        }
      }

      function drawFrame(index) {
        if (frameCache.has(index)) {
          ctx.putImageData(frameCache.get(index), 0, 0);
        } else if (!inProgressFrames.has(index)) fetchFrame(index);

        // Always prefetch ahead
        for (
          let i = index + 1;
          i <= Math.min(index + 10, totalFrames - 1);
          i++
        ) {
          fetchFrame(i);
        }
      }

      function nextFrame() {
        if (frame < totalFrames - 1) {
          frame++;
          frameSlider.value = frame;
          drawFrame(frame);
        }
      }

      function previousFrame() {
        if (frame > 0) {
          frame--;
          frameSlider.value = frame;
          drawFrame(frame);
        }
      }

      function fetchAllFrames() {
        for (let i = 0; i < totalFrames; i++) {
          fetchFrame(i);
        }
      }
      let isPlaying = false;
      let lastFrameTime = 0;

      function playVideo() {
        if (loadedFrames < totalFrames) {
          status.textContent = `Loading frames... ${loadedFrames}/${totalFrames}`;
          return;
        }

        if (isPlaying) return;

        isPlaying = true;
        requestAnimationFrame(playLoop);
      }

      function playLoop(time) {
        if (!isPlaying) return;

        if (time - lastFrameTime >= 1000 / 30) {
          if (frame >= totalFrames - 1) {
            stopVideo();
            return;
          }

          frame++;
          frameSlider.value = frame;
          drawFrame(frame);

          lastFrameTime = time;
        }

        requestAnimationFrame(playLoop);
      }

      function stopVideo() {
        isPlaying = false;
      }
      frameSlider.addEventListener("input", () => {
        frame = Number(frameSlider.value);
        drawFrame(frame);
      });
    </script>
  </body>
</html>
