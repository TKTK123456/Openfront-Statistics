<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Game <%= gameId %></title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #1b1b1b;
        color: white;
      }

      header {
        padding: 20px;
        background: #252525;
        border-bottom: 1px solid #444;
      }

      h1 {
        margin: 0;
      }

      main {
        max-width: 1200px;
        margin: auto;
        padding: 25px;
      }

      .card {
        background: #2b2b2b;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 30px;
      }

      img,
      canvas {
        width: 100%;
        image-rendering: pixelated;
        border: 1px solid #444;
      }

      button {
        margin-top: 10px;
      }

      .progress {
        width: 100%;
        height: 20px;
      }

      code {
        color: #7ed6ff;
      }

      .map-stack {
        position: relative;
        width: 100%;
        display: inline-block;
      }

      .map-stack img,
      .map-stack canvas {
        display: block;
        width: 100%;
        image-rendering: pixelated;
        border: 1px solid #444;
      }

      .map-stack img {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .map-stack canvas {
        position: absolute;
        inset: 0;
        background: transparent;
      }

      .map-stack canvas:last-of-type {
        position: relative;
      }
      [hidden] {
        display: none !important;
      }
    </style>
  </head>

  <body>
    <header>
      <h1>OpenFront Game Analysis Viewer</h1>
      <p>
        Game ID: <code><%= gameId %></code>
      </p>
    </header>

    <main>
      <div class="card">
        <h2>Status</h2>

        <p id="status">Connecting...</p>

        <progress id="progress" max="100" value="0" class="progress"></progress>
      </div>

      <div class="card">
        <h2>Conquered Tiles Heatmap</h2>
        <img id="conquered" />
      </div>

      <div class="card">
        <h2>Trade Ship Routes Heatmap</h2>
        <img id="trade" />
      </div>

      <div class="card">
        <h2>Pirating Heatmap</h2>
        <img id="pirating" />
      </div>

      <div class="card">
        <h2>Timelapses</h2>
        <input
          type="checkbox"
          id="showTileConquered"
          name="showTileConquered"
          value="on"
          checked
        />
        <label for="showTileConquered">Tiles Conquered</label>
        <input
          type="checkbox"
          id="showTradeRoutes"
          name="showTradeRoutes"
          value="on"
          checked
        />
        <label for="showTradeRoutes">Trade Routes</label>
        <div class="map-stack">
          <img class="background" />
          <canvas id="borderMap" style="z-index: 1"></canvas>
          <canvas id="map" style="z-index: 2"></canvas>
          <canvas id="tradeRouteMap" style="z-index: 3"></canvas>
          <canvas id="mask" style="z-index: 4"></canvas>
        </div>

        <div
          style="
            margin-top: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
          "
        >
          <button name="play" hidden>Play</button>
          <button name="pause" hidden>Pause</button>
          <button name="previous">◀ Previous</button>

          <input
            id="frameSlider"
            type="range"
            min="0"
            max="0"
            value="0"
            style="flex: 1"
          />

          <button name="next">Next ▶</button>
        </div>
        <br />
        <div
          style="
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: nowrap;
            white-space: nowrap;
          "
        >
          <label for="timelapseProgress">Frame loading progress:</label>
          <progress
            class="progress"
            id="timelapseProgress"
            max="100"
            value="0"
          ></progress>
          <span id="timelapse%">0.00%</span>
        </div>
      </div>
      <div class="card" id="render" hidden>
        <h2>Render MP4 Video</h2>
        <div
          style="
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: nowrap;
            white-space: nowrap;
          "
        >
          <label for="renderProgress">Frames rendering progress:</label>
          <progress
            class="progress"
            id="renderProgress"
            max="100"
            value="0"
          ></progress>
          <span id="rendered%">0.00%</span>
        </div>
        <input
          type="checkbox"
          id="renderTileConquered"
          name="renderTileConquered"
          value="on"
          checked
        />
        <label for="renderTileConquered">Tiles Conquered</label>
        <input
          type="checkbox"
          id="renderTradeRoutes"
          name="renderTradeRoutes"
          value="on"
          checked
        />
        <label for="renderTradeRoutes">Trade Routes</label>
        <button name="renderVideo">Render MP4 file</button>
      </div>
    </main>
    <script>
      window.gameId = "<%= gameId %>";
    </script>
    <script type="module" src="/client/main.ts"></script>
  </body>
</html>
